# Forge Dispatch — required environment variables
# Copy this file to .env and fill in your values. Never commit .env.

# OpenRouter — get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Model selection — choose one of the free models below:
#   minimax/minimax-m2.7:free          (MiniMax M2.7 — built for multi-agent, 197K ctx)
#   thinkingmachines/inkling:free      (Inkling — 975B MoE, multimodal, 41B active)
#   nvidia/nemotron-3-super-120b-a12b:free  (Nemotron 3 Super — 120B, 1M ctx, agentic)
FORGE_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# GitHub — read-only token (public repos are fine for eval cases)
GITHUB_TOKEN=github_pat_...

# Linear — read-only API key
LINEAR_API_KEY=lin_api_...
