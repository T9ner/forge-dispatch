# Forge Dispatch — environment configuration
# Copy this file to .env and configure your preferred provider. Never commit .env.

# --- Option 1: OpenRouter (Default / Free Open-Source Models) ---
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Examples: minimax/minimax-m2.7:free, nvidia/nemotron-3-super-120b-a12b:free, meta-llama/llama-3.3-70b-instruct:free

# --- Option 2: OpenAI Direct ---
# OPENAI_API_KEY=sk-...
# Examples: gpt-4o, gpt-4o-mini, o3-mini

# --- Option 3: Anthropic Direct ---
# ANTHROPIC_API_KEY=sk-ant-...
# Examples: claude-3-5-sonnet-latest, claude-3-7-sonnet-latest, claude-3-5-haiku-latest

# --- Option 4: Custom OpenAI-Compatible Endpoint (Ollama, vLLM, Groq, Together, Mistral) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=your-custom-key

# --- Model Selection (Optional, defaults per provider) ---
FORGE_MODEL=minimax/minimax-m2.7:free

# --- Live Mode Tool Credentials (Optional for evaluation; uses mock data by default) ---
GITHUB_TOKEN=github_pat_...
LINEAR_API_KEY=lin_api_...
